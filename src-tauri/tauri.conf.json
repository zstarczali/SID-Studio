{
  "productName": "VA SID Editor",
  "version": "1.0.0",
  "identifier": "hu.zstarczali.vasideditor",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VA SID Editor",
        "url": "index.html",
        "width": 1400,
        "height": 940,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#03020c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' blob: ipc: http://ipc.localhost; media-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png"
    ]
  }
}
