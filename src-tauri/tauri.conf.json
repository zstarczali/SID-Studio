{
  "productName": "VA SID Studio",
  "version": "1.7.1",
  "identifier": "hu.zstarczali.vasidstudio",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VA SID Studio",
        "url": "index.html",
        "width": 1400,
        "height": 940,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#03020c",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' blob: ipc: http://ipc.localhost; media-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["sidpl"],
        "name": "SID Playlist",
        "description": "VA SID Studio playlist",
        "role": "Viewer",
        "mimeType": "application/x-sidpl"
      }
    ],
    "resources": {
      "../docs/VA SID Studio Manual.pdf": "docs/VA SID Studio Manual.pdf"
    },
    "linux": {
      "appimage": { "bundleMediaFramework": true },
      "deb": { "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-alsa", "gstreamer1.0-pulseaudio"] },
      "rpm": { "depends": ["gstreamer1-plugins-base", "gstreamer1-plugins-good"] }
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png"
    ]
  }
}
